
# ===== AI / LLM =====
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ===== WHATSAPP / META CLOUD API =====
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=        # choose any random string; enter the same in Meta webhook config
WHATSAPP_API_VERSION=v24.0

# ===== MONGODB =====
MONGO_PASSWORD=                # used by docker-compose to init the MongoDB root user
# URI for the app — uses service name "mongodb" inside Docker; localhost for local dev
MONGODB_URI=                   # e.g. mongodb://remedi:<MONGO_PASSWORD>@mongodb:27017/remedi_chronic_care?authSource=admin
DB_NAME=remedi_chronic_care

# ===== REDIS (future) =====
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379
REDIS_PASSWORD=

# ===== MINIO OBJECT STORAGE (future) =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=remedi
MINIO_SECRET_KEY=
MINIO_BUCKET_REPORTS=patient-reports
MINIO_BUCKET_PDFS=annual-reports
MINIO_SECURE=false

# ===== AUTH / SECURITY =====
JWT_SECRET=                   # generate with: openssl rand -hex 32
JWT_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_FORM_SECRET=           # shared secret between Google Apps Script and this server

# ===== APPLICATION =====
ENVIRONMENT=development
PORT=8000
DEBUG=true
HOST=0.0.0.0

# ===== BUSINESS / CONTACT =====
REGISTRATION_FORM_URL=
PAYMENT_LINK=
SUPPORT_PHONE=
EMERGENCY_PHONE=

# ===== ADMIN =====
ADMIN_EMAIL=
ADMIN_PHONE=
